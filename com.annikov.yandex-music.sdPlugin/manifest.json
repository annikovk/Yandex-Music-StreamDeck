{
	"Name": "Yandex Music",
	"Version": "1.0.9",
	"Author": "Konstantin Annikov",
	"PropertyInspectorPath": "ui/global-settings.html",
	"Actions": [
		{
			"Name": "Play/Pause",
			"UUID": "com.annikov.yandex-music.play-pause",
			"Icon": "imgs/actions/ym-play",
			"Tooltip": "Toggle playback and display current track cover",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/ym-pause",
					"Name": "Paused"
				},
				{
					"Image": "imgs/actions/ym-play",
					"Name": "Playing"
				}
			]
		},
		{
			"Name": "Previous Track",
			"UUID": "com.annikov.yandex-music.previous",
			"Icon": "imgs/actions/actions-icons/list/back",
			"Tooltip": "Previous track",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/actions-icons/white/back"
				}
			]
		},
		{
			"Name": "Next Track",
			"UUID": "com.annikov.yandex-music.next",
			"Icon": "imgs/actions/actions-icons/list/next",
			"Tooltip": "Next track",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/actions-icons/white/next"
				}
			]
		},
		{
			"Name": "Like",
			"UUID": "com.annikov.yandex-music.like",
			"Icon": "imgs/actions/actions-icons/list/like-0",
			"Tooltip": "Like current track",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/actions-icons/white/like-0",
					"Name": "Not Liked"
				},
				{
					"Image": "imgs/actions/actions-icons/white/like-1",
					"Name": "Liked"
				}
			]
		},
		{
			"Name": "Dislike",
			"UUID": "com.annikov.yandex-music.dislike",
			"Icon": "imgs/actions/actions-icons/list/dislike",
			"Tooltip": "Dislike current track",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/actions-icons/white/dislike"
				}
			]
		},
		{
			"Name": "Mute",
			"UUID": "com.annikov.yandex-music.mute",
			"Icon": "imgs/actions/actions-icons/list/sound-on",
			"Tooltip": "Toggle mute",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/actions-icons/white/sound-on",
					"Name": "Sound On"
				},
				{
					"Image": "imgs/actions/actions-icons/white/sound-off",
					"Name": "Sound Off"
				}
			]
		}
	],
	"Category": "Yandex Music",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Control Yandex Music desktop app with Stream Deck",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.annikov.yandex-music"
}
